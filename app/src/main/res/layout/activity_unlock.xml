<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ImageButton
        android:id="@+id/back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:src="@drawable/ic_back"
        app:tint="@color/text" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Unlock"
                android:textColor="@color/text"
                android:textSize="30sp" />

            <!-- Stage: intro -->
            <LinearLayout
                android:id="@+id/stageIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Turning off LCKDN takes real effort. That is the point."
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/introNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView style="@style/SectionHeader" android:text="HOW IT WORKS" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView style="@style/CardTitle" android:text="1 · Type the code" />
                    <TextView
                        style="@style/CardBody"
                        android:text="Copy 480 random characters by hand. One mistake and you start over. Pasting is detected and resets you." />

                    <TextView
                        style="@style/CardTitle"
                        android:layout_marginTop="16dp"
                        android:text="2 · Wait 60 minutes" />
                    <TextView
                        style="@style/CardBody"
                        android:text="A cooldown starts. Restarting your phone restarts the timer." />

                    <TextView
                        style="@style/CardTitle"
                        android:layout_marginTop="16dp"
                        android:text="3 · Confirm within 10 minutes" />
                    <TextView
                        style="@style/CardBody"
                        android:text="Miss the window and protection stays on." />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stayButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="28dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Stay locked in"
                    android:textSize="16sp"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/beginButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:text="Start unlock challenge"
                    android:textColor="@color/text_dim" />
            </LinearLayout>

            <!-- Stage: typing -->
            <LinearLayout
                android:id="@+id/stageTyping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Type the code exactly, including spaces."
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/challenge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_card"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="6dp"
                    android:padding="18dp"
                    android:textColor="@color/text_dim"
                    android:textIsSelectable="false"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:fontFamily="monospace"
                    android:gravity="top"
                    android:hint="Start typing…"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword|textNoSuggestions|textMultiLine"
                    android:longClickable="false"
                    android:minLines="3"
                    android:padding="18dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_faint"
                    android:textIsSelectable="false"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/typingMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/danger"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_faint"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stage: cooldown -->
            <LinearLayout
                android:id="@+id/stageCooldown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Cooldown in progress. Protection stays on until it ends."
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:fontFamily="sans-serif-thin"
                    android:textColor="@color/text"
                    android:textSize="72sp" />

                <TextView
                    android:id="@+id/cooldownNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/text_faint"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView style="@style/CardTitle" android:text="While you wait" />
                    <TextView
                        style="@style/CardBody"
                        android:text="Do 20 push-ups. Drink a glass of water. Walk outside for ten minutes. Message someone you care about. Write down why you locked in.\n\nIf you still want to unlock in an hour, you can." />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="28dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Cancel and stay locked in"
                    android:textSize="16sp"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <!-- Stage: ready -->
            <LinearLayout
                android:id="@+id/stageReady"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="You made it through the cooldown. You can turn protection off now, or keep your streak going."
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/readyTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/text_faint"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keepButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="28dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Keep me locked in"
                    android:textSize="16sp"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/turnOffButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:text="Turn off protection"
                    android:textColor="@color/danger" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
